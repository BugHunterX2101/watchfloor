// Merge into ~/.kiro/agents/kirocrew.json; keep everything already there.
// Kiro Crew reads this file as JSONC. On Windows the app wrote this entry itself from
// ~/.kiro/settings/mcp.json (tried 2026-10-23, ADR-034); merge by hand only if it is missing.
{
  "includeMcpJson": false, // pinned by Kiro Crew: the entry must live here, not only in ~/.kiro/settings/mcp.json
  "mcpServers": {
    "watchfloor": {
      "url": "https://watchfloor.onrender.com/mcp",
      "oauth": {
        "clientId": "wf-kiro",
        "redirectUri": "http://127.0.0.1:7778/oauth/callback",
        "oauthScopes": ["watchfloor.read"]
      }
    }
  },
  // Add the ref to "tools". The app also added it to "allowedTools" and a "watchfloor/*" allow rule, which
  // auto-approves every call; that is acceptable because wf-kiro cannot write. Delete both for a prompt per call.
  "tools": ["@watchfloor"]
}
